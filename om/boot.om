note SPDX-License-Identifier: MIT OR GPL-2.0-only
note boot: the GB10B and GB20B GSP start-up as a pure-Omega step machine. Omega decides every
note register access; the kernel glue only performs the one action it is handed and calls again.
note GB10B path (st 25 = 0): port of aien-dev/aienux c9678d7b native/kernel/gpu/gsp_mmio.c.
note GB20B path (st 25 = 1): port of NVIDIA open-gpu-kernel-modules 580.173.02
note kernel_sec2_gb20b.c (FWSEC scratch 0x5e0 == 0xff, COTv2/no-FRTS header check, SEC2 MSGQ
note 0x840c80/0x840c84 reply over EMEM AINCR, TAIL-before-HEAD ack, SEC2_RESPONSE 0x1510de7e,
note COT cmd 0x14, FSP_OK 0) and ogd-qual-gsp/gsp/sec2.om, plus shared GSP mask/lockdown/FMC/
note FALCON_OS/RISC-V active steps with 0xbadf41xx target-mask guard in step 8.
note
note st (32 ulong, caller zeroes it and sets the inputs):
note   0 pc (0 = start)  1 packet bytes 1..1024  2 FMC boot-argument address  3 appVersion
note   4..7 poll budgets for steps 1, 6 (and GB20B step 0), 7, 8   8 poll counter
note   9 packet byte index  10 EMEM start  11 SEC2 QUEUE_HEAD or MSGQ_HEAD
note   12 stage: 0 ok, 1 arg, 2 busy, 3 emem, 4 sec2, 5 mask, 6 lockdown, 7 fmc, 8 riscv
note   13..16 polls used by steps 1, 6, 7, 8  17 dwords  18 EMEMC after
note   19 SEC2 MAILBOX0 (GB10B) or SEC2 reply error / scratch (GB20B)
note   20 SEC2 MAILBOX1 (GB10B) or SEC2 reply task ID (GB20B)
note   21 HWCFG2  22 GSP MAILBOX0  23 GSP MAILBOX1  24 CPUCTL
note   25 profile (0 = GB10B, 1 = GB20B)  26 reply dwords  27 reply idx / ememc_end
note   28 reply w0  29 reply w1  30 reply w3  31 reply w4
note act (4 ulong) written on result 0: 0 kind (1 read, 2 write, 3 pause), 1 BAR0 offset, 2 value.
note obs = previous read value (0 after write or pause). Result: 0 = act, 1 = finished (st 12).
note Register/constant decimals (aien-calc eval, 2026-11-18):
note   NV_PMC_SCRATCH_RESET_PLUS_2 0x5e0 = 1504; SEC2 MAILBOX0 0x840040 = 8650816,
note   MAILBOX1 0x840044 = 8650820, EMEMC0 0x840ac0 = 8653504, EMEMD0 0x840ac4 = 8653508,
note   QHEAD0 0x840c00 = 8653824, QTAIL0 0x840c04 = 8653828, MSGQ_HEAD0 0x840c80 = 8653952,
note   MSGQ_TAIL0 0x840c84 = 8653956; GSP MAILBOX0 0x110040 = 1114176, MAILBOX1 0x110044 = 1114180,
note   FALCON_OS 0x110080 = 1114240, HWCFG2 0x1100f4 = 1114356, CPUCTL 0x111388 = 1119112;
note   AINCW 0x1000000 = 16777216, AINCR 0x2000000 = 33554432, MCTP SOM|EOM 0xc0000000 = 3221225472,
note   NVDM COT 0x1410de7e = 336649854, NVDM SEC2_RESPONSE 0x1510de7e = 353427070 (IC mask 0xffffff7f = 4294967167),
note   COTv2 hdr (860<<16)|2 = 56360962, busy 0xc001cafe = 3221342974,
note   locked 0xbadf4100 = 3135193344 under mask 0xffffff00 = 4294967040, lockdown 0x2000 = 8192.
fn bact act edit ulong 4 kind ulong off ulong val ulong to ulong
put act 0 kind
put act 1 off
put act 2 val
ret 0
end
fn bfin st edit ulong 32 stage ulong to ulong
put st 12 stage
put st 0 99
ret 1
end
fn ememdw v ulong to ulong
ret add mul and shr v 8 255 64 and shr v 2 63
end
fn pword pkt view uchar 1024 i ulong n ulong to ulong
w = ulong 0
for k ulong 4
if lt add i k n
w = or w shl ulong get pkt add i k mul k 8
end
end
ret w
end
note GB20B COTv2 packet header check before any MMIO access.
fn bcot2 pkt view uchar 1024 n ulong to bool
if ne n 868
ret false
end
if ne pword pkt 0 n 3221225472
ret false
end
if ne pword pkt 4 n 336649854
ret false
end
if ne pword pkt 8 n 56360962
ret false
end
for k ulong 6
if ne pword pkt add 20 mul k 4 n 0
ret false
end
end
ret true
end
note GB20B Step 0: wait FWSEC secure boot NV_PMC_SCRATCH_RESET_PLUS_2 (0x5e0) == 0xFF.
fn bstep0 st edit ulong 32 obs ulong act edit ulong 4 to ulong
pc = get st 0
if eq pc 1
put st 0 2
ret bact act 1 1504 0
end
if eq obs 255
put st 8 0
put st 0 10
ret 2
end
n = get st 8
if ge n get st 5
put st 19 obs
ret bfin st 4
end
put st 8 add n 1
put st 0 1
ret bact act 3 0 0
end
note Step 1: SEC2 channel empty. pc 10 read HEAD, 11 read TAIL, 12 compare.
fn bstep1 st edit ulong 32 obs ulong act edit ulong 4 to ulong
pc = get st 0
if eq pc 10
put st 0 11
ret bact act 1 8653824 0
end
if eq pc 11
put st 11 obs
put st 0 12
ret bact act 1 8653828 0
end
n = get st 8
if eq get st 11 obs
put st 13 n
put st 8 0
put st 0 20
ret 2
end
if ge n get st 4
put st 13 n
ret bfin st 2
end
put st 8 add n 1
put st 0 10
ret bact act 3 0 0
end
note Steps 2-5: packet into EMEM, write pointer check, TAIL then HEAD.
fn bstep2 st edit ulong 32 pkt view uchar 1024 obs ulong act edit ulong 4 to ulong
pc = get st 0
if eq pc 20
put st 0 21
ret bact act 2 8653504 16777216
end
if eq pc 21
put st 0 22
ret bact act 1 8653504 0
end
if eq pc 22
put st 10 ememdw obs
put st 9 0
put st 0 23
end
pc = get st 0
n = get st 1
i = get st 9
if eq pc 23
if lt i n
put st 9 add i 4
ret bact act 2 8653508 pword pkt i n
end
put st 0 25
ret bact act 1 8653504 0
end
if eq pc 25
dw = div add n 3 4
put st 17 dw
put st 18 obs
if ne sub ememdw obs get st 10 dw
ret bfin st 3
end
put st 0 26
ret bact act 2 8653828 sub mul dw 4 4
end
put st 8 0
if eq get st 25 1
put st 0 35
else
put st 0 30
end
ret bact act 2 8653824 0
end
note GB10B Step 6: SEC2 handled the command (MAILBOX0 no longer 0xc001cafe).
fn bstep6 st edit ulong 32 obs ulong act edit ulong 4 to ulong
pc = get st 0
if eq pc 30
put st 0 31
ret bact act 1 8650816 0
end
if eq pc 32
put st 20 obs
ret bfin st 4
end
put st 19 obs
n = get st 8
if ne obs 3221342974
put st 14 n
put st 8 0
put st 0 40
ret 2
end
if ge n get st 5
put st 14 n
put st 0 32
ret bact act 1 8650820 0
end
put st 8 add n 1
put st 0 30
ret bact act 3 0 0
end
note GB20B Step 6a: poll SEC2 MSGQ HEAD != TAIL, validate packet size, arm EMEMC AINCR.
fn bgb20 st edit ulong 32 obs ulong act edit ulong 4 to ulong
pc = get st 0
if eq pc 35
put st 0 36
ret bact act 1 8653952 0
end
if eq pc 36
put st 11 obs
put st 0 37
ret bact act 1 8653956 0
end
h = get st 11
n = get st 8
if ne h obs
put st 14 n
if or lt obs h gt obs 1020
put st 19 1001
ret bfin st 4
end
sz = add sub obs h 4
if or lt sz 20 ne rem sz 4 0
put st 19 1001
ret bfin st 4
end
put st 26 div sz 4
put st 27 0
put st 0 70
ret bact act 2 8653504 33554432
end
if ge n get st 5
put st 14 n
put st 19 1000
ret bfin st 4
end
put st 8 add n 1
put st 0 35
ret bact act 3 0 0
end
note GB20B Step 6b: read reply words via EMEMD, read EMEMC, ack TAIL then HEAD, check reply.
fn bgb20r st edit ulong 32 obs ulong act edit ulong 4 to ulong
pc = get st 0
if eq pc 70
if lt get st 27 get st 26
put st 0 71
ret bact act 1 8653508 0
end
put st 0 72
ret bact act 1 8653504 0
end
if eq pc 71
i = get st 27
if eq i 0
put st 28 obs
end
if eq i 1
put st 29 obs
end
if eq i 2
put st 20 obs
end
if eq i 3
put st 30 obs
end
if eq i 4
put st 31 obs
put st 19 obs
end
put st 27 add i 1
put st 0 70
ret 2
end
if eq pc 72
put st 27 ememdw obs
put st 0 73
ret bact act 2 8653956 get st 11
end
if eq pc 73
put st 0 74
ret bact act 2 8653952 get st 11
end
if ne get st 27 get st 26
put st 19 1002
ret bfin st 4
end
if ne and get st 28 3221225472 3221225472
put st 19 1003
ret bfin st 4
end
if ne and get st 29 4294967167 353427070
put st 19 1004
ret bfin st 4
end
if ne get st 30 20
put st 19 1005
ret bfin st 4
end
if ne get st 31 0
ret bfin st 4
end
put st 8 0
put st 0 40
ret 2
end
note Step 7: GSP target mask released: HWCFG2 non-zero and not 0xbadf41xx.
fn bstep7 st edit ulong 32 obs ulong act edit ulong 4 to ulong
pc = get st 0
if eq pc 40
put st 0 41
ret bact act 1 1114356 0
end
put st 21 obs
n = get st 8
if and ne obs 0 ne and obs 4294967040 3135193344
put st 15 n
put st 8 0
put st 0 50
ret 2
end
if ge n get st 6
put st 15 n
ret bfin st 5
end
put st 8 add n 1
put st 0 40
ret bact act 3 0 0
end
note Step 8 continued: not released yet; budget check, then pause or give up.
fn bwait8 st edit ulong 32 act edit ulong 4 to ulong
n = get st 8
if ge n get st 7
put st 16 n
put st 0 56
ret bact act 1 1114180 0
end
put st 8 add n 1
put st 0 50
ret bact act 3 0 0
end
note Step 8: lockdown released or an FMC code. Ignore 0xbadf41xx PRI target-locked reads.
fn bstep8 st edit ulong 32 obs ulong act edit ulong 4 to ulong
pc = get st 0
pa = get st 2
if eq pc 50
put st 0 51
ret bact act 1 1114176 0
end
if eq pc 56
put st 23 obs
ret bfin st 6
end
if eq pc 51
put st 22 obs
if eq and obs 4294967040 3135193344
ret bwait8 st act
end
if and ne obs 0 eq obs and pa 4294967295
put st 0 52
ret bact act 1 1114180 0
end
put st 0 53
ret bact act 1 1114356 0
end
if eq pc 52
put st 23 obs
if eq obs shr pa 32
ret bwait8 st act
end
put st 0 53
ret bact act 1 1114356 0
end
put st 21 obs
if or eq obs 0 eq and obs 4294967040 3135193344
ret bwait8 st act
end
if or eq and obs 8192 0 ne get st 22 0
put st 16 get st 8
put st 0 60
ret bact act 1 1114176 0
end
ret bwait8 st act
end
note Steps 9-11: FMC error check, FALCON_OS, RISC-V active.
fn bstep9 st edit ulong 32 obs ulong act edit ulong 4 to ulong
pc = get st 0
if eq pc 60
put st 22 obs
if ne obs 0
ret bfin st 7
end
put st 0 62
ret bact act 2 1114240 and get st 3 4294967295
end
if eq pc 62
put st 0 63
ret bact act 1 1119112 0
end
put st 24 obs
if eq and obs 128 0
ret bfin st 8
end
ret bfin st 0
end
note Entry. Each call runs at most a few internal transitions (helpers return 2) before an action.
fn agpu_boot_next st edit ulong 32 pkt view uchar 1024 obs ulong act edit ulong 4 to ulong
if eq get st 0 0
for k ulong 17
put st add k 8 0
end
for k ulong 6
put st add k 26 0
end
prof = get st 25
if gt prof 1
ret bfin st 1
end
n = get st 1
if eq prof 1
if not bcot2 pkt n
ret bfin st 1
end
put st 0 1
else
if or eq n 0 gt n 1024
ret bfin st 1
end
put st 0 10
end
end
r = ulong 2
while eq r 2 bound 8
pc = get st 0
if eq pc 99
ret 1
end
if lt pc 10
r = bstep0 st obs act
else
if lt pc 20
r = bstep1 st obs act
else
if lt pc 30
r = bstep2 st pkt obs act
else
if lt pc 35
r = bstep6 st obs act
else
if lt pc 40
r = bgb20 st obs act
else
if lt pc 50
r = bstep7 st obs act
else
if lt pc 60
r = bstep8 st obs act
else
if lt pc 70
r = bstep9 st obs act
else
r = bgb20r st obs act
end
end
end
end
end
end
end
end
end
ret r
end
